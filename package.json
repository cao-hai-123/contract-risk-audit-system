    "backup:verify": "node scripts/full-backup.js verify",
    "backup:restore-files": "node scripts/full-backup.js restore-files",
    "test:qwen": "node --test --test-isolation=none tests/local-inference.test.js",
    "test:qwen:workflow": "node scripts/test-qwen-workflow.js",
    "seal:setup": "node scripts/setup-seal-runtime.js",
    "test:seal": "node --test tests/seal-module.test.js",
    "test:seal:integration": "node scripts/test-seal-integration.js",
    "corpus:build": "node scripts/build-real-contract-library.js",
    "corpus:publish": "node scripts/build-real-contract-library.js --publish",
    "corpus:summarize": "node scripts/summarize-real-contract-library.js",
