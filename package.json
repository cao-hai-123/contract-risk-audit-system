    "training:embedding:validate": "node scripts/validate-legal-embedding-training.js",
    "standard-library:build": "node scripts/build-standard-clause-library.js",
    "standard-library:build:deepseek": "node scripts/build-standard-clause-library.js --deepseek",
    "test:standard-match": "node scripts/evaluate-standard-clause-fixtures.js",
    "test:standard-match:deepseek": "node scripts/evaluate-standard-clause-fixtures.js --deepseek",
    "test:famie": "node scripts/test-famie-integration.js",
    "test:assistant": "node scripts/test-contract-assistant.js",
    "test:report-management": "node scripts/test-report-management.js",
    "test:priority": "node --test --test-isolation=none tests/priority-repairs.test.js",
    "test:priority:mysql": "node scripts/test-priority-mysql.js",
    "test:priority:http": "node scripts/test-priority-http.js",
    "famie:start": "node scripts/start-famie.js",
    "test:enhanced": "node --test --test-isolation=none tests/performance-library-famie.test.js",
