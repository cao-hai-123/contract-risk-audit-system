    "local-model:test": "node scripts/test-embedded-model.js",
    "embedding-model:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-embedding-model.ps1",
    "embedding-model:test": "node scripts/test-embedding-model.js",
