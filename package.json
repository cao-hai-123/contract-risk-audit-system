  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@vitejs/plugin-vue": "^5.2.4",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "tesseract.js": "^7.0.0",
    "vite": "^6.0.5",
    "vue": "^3.5.13",
    "word-extractor": "^1.0.4"
